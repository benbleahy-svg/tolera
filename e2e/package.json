{
  "name": "tolera-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playwright demo-test harness — the 14 acceptance demos as automated click-throughs.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:demo": "playwright test --grep",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@clerk/testing": "^1.0.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
