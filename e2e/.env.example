# Copy to e2e/.env and fill from the Tolera vault (dev Clerk instance + a seeded pilot user).
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:8000

# Clerk dev instance — clerkSetup() uses the secret key to mint a Testing Token.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# A seeded user in the Fechner pilot org (created by the seed framework, M0.5).
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
