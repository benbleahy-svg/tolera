# Frontend env contract (Vite). Copy to `frontend/.env` (gitignored) for local
# dev. Only VITE_-prefixed vars are exposed to the client bundle. NEVER put a
# secret here — these values ship to the browser.

# Clerk frontend (publishable) key — the SAME value as the backend
# CLERK_PUBLISHABLE_KEY; the publishable key is not a secret.
VITE_CLERK_PUBLISHABLE_KEY=

# API origin. Leave empty in dev — the Vite proxy forwards /api → FastAPI (:8000).
# Set for split deployments (e.g. https://api.tolera.eu).
VITE_API_BASE_URL=

# BRAND config — parameterised from day one (DECISIONS.md "Product name and
# domain"). Unset = the Tolera defaults baked into src/brand.ts.
VITE_BRAND_NAME=Tolera
VITE_BRAND_SHORT_NAME=T
VITE_BRAND_DOMAIN=tolera.eu
VITE_BRAND_APP_DOMAIN=app.tolera.eu
VITE_BRAND_RFQ_DOMAIN=rfq.tolera.eu
VITE_BRAND_LOGO_URL=
VITE_BRAND_PRIMARY_COLOR=
