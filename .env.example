# .env.example — the contract for what the app needs. NAMES ONLY, no values. This file IS committed.
# To use it: copy to .env (which is gitignored and never committed) and fill in the values from your vault.
#   cp .env.example .env

# --- Auth (Clerk, EU) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Database / cache (local Docker for dev) ---
DATABASE_URL=
REDIS_URL=

# --- Object storage (Hetzner, S3-compatible, EU) ---
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# --- Email (Mailgun EU) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=rfq.tolera.eu
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_BASE_URL=https://api.eu.mailgun.net

# --- LLM (Anthropic, under DPA) — paste the ROTATED key here in .env, not this file ---
ANTHROPIC_API_KEY=

# --- Email threading / SSO ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=

# --- App ---
BRAND=tolera
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
DEFAULT_LOCALE=de-DE
