# Committed env contract — names + non-secret config defaults only, NEVER secret
# values. Copy to `.env` (gitignored) and fill secrets from the `Tolera` vault.
# Real environment variables override `.env`.

# --- Auth (Clerk, EU) — wired in M0.2 ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# --- Database / cache (Hetzner; local: Docker Compose services `db`/`redis`) ---
DATABASE_URL=postgresql+asyncpg://tolera:tolera@localhost:5432/tolera
REDIS_URL=redis://localhost:6379/0
# --- Object storage (S3-compatible, EU) — M1.2 ---
# STORAGE_BACKEND: "memory" (dev/test, no external dep) or "s3". docker-compose
# sets "s3" against MinIO; prod sets "s3" against an EU-resident bucket (provider
# still OPEN — EU data residency, see DECISIONS.md 2026-06-25).
STORAGE_BACKEND=memory
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=tolera-files
S3_REGION=eu-central-1
MAX_UPLOAD_MB=200
# --- Email (Mailgun EU) — M3 ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=rfq.tolera.eu
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_BASE_URL=https://api.eu.mailgun.net
# --- LLM (Anthropic, under DPA) — M3 ---
ANTHROPIC_API_KEY=
# --- Email threading / SSO — M3 ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
# --- App ---
BRAND=tolera
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
DEFAULT_LOCALE=de-DE
LOG_LEVEL=INFO
