# --- OS junk ---
.DS_Store
**/.DS_Store

# --- Large binary reference: kept on disk, NOT in git (git-lfs unavailable) ---
# 125 MB of PP screenshots. To version them later:
#   git lfs install && git lfs track "docs/reference/screenshots/**"
#   then remove the line below and commit.
docs/reference/screenshots/

# --- Paperless Parts KB (tier 5): track the markdown; keep generated/heavy out of git ---
docs/reference/kb/**/*.html
docs/reference/kb/**/*.zip

# --- Superseded / history (kept on disk, out of the repo) ---
archive/
Video Analysis/

# --- Secrets / environment ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / frontend ---
node_modules/
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# --- Logs / misc ---
*.log
.cache/
coverage/
