  PART {
    uuid id PK
    string part_number
    string revision
    bool is_assembly
    bool is_root_part
    enum obtain_method "PURCHASED|MANUFACTURED"
  }
  NODE {
    uuid id PK
    uuid part_id FK
    uuid parent_node_id FK
    int qty_relative_to_parent
  }
  COMPONENT {
    uuid id PK
    uuid part_id FK
    uuid process_id FK
    bool is_root_component
  }
  COMPONENT_QUANTITY {
    int quantity
    int make_quantity
    int deliver_quantity
    money unit_cost
    money unit_price
    money total_price
    int lead_time_days
  }
  QUOTE {
    uuid id PK
    string number
    int revision
    enum status "draft|sent|won|lost|expired"
  }
  QUOTE_ITEM {
    uuid id PK
    int position
    enum workflow_status "in_progress|on_hold|completed"
    bool was_won
  }
